# Environment settings for the public Elastic Beanstalk demo (no secrets here).
option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    # Fictional-data classroom demo: demo users + simulated AI (Claude is never called).
    PUBLIC_DEMO: "true"
    AI_MODE: demo
    # Single-instance environment = plain HTTP (no load balancer / certificate).
    FORCE_HTTPS: "false"
    PGLITE_DATA_DIR: /var/app/granttrail-data/pglite
    LOCAL_STORAGE_DIR: /var/app/granttrail-data/uploads
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
