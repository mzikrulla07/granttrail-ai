# ------------------------------------------------------------------
# GrantTrail AI — environment configuration
# Copy to .env (never commit .env). Every value below is safe to leave
# as-is for local DEMO MODE: no Claude key, no AWS account required.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=3001
# Browser origin allowed by CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# ---------------- Database ----------------
# Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) stored in PGLITE_DATA_DIR.
# Point it at local Postgres or Amazon RDS for PostgreSQL, e.g.
#   postgres://granttrail:granttrail@localhost:5432/granttrail
#   postgres://USER:PASSWORD@your-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/granttrail
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite
# Set to true for RDS (TLS required in production)
DATABASE_SSL=false
# Seed fictional demo records automatically when the database is empty
AUTO_SEED=true

# ---------------- AI extraction ----------------
# auto  = use Claude when ANTHROPIC_API_KEY is set, otherwise DEMO MODE
# demo  = always use the simulated (rule-based) extractor
# claude = always use Claude (fails fast if no key)
AI_MODE=auto
# Server-side only. Never prefix with VITE_ and never send to the browser.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=60000
# Maximum characters of agreement text sent to the model
AI_MAX_INPUT_CHARS=120000

# ---------------- Document storage ----------------
# local = files on disk (development). s3 = Amazon S3 with server-side encryption.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage/uploads
AWS_REGION=us-east-1
S3_BUCKET=
# Optional customer-managed KMS key; when blank S3 uses SSE-S3 (AES-256)
S3_KMS_KEY_ID=

# ---------------- Authentication ----------------
# dev     = seeded demo users selected in the UI (refused when NODE_ENV=production)
# cognito = Amazon Cognito access tokens (Authorization: Bearer <jwt>)
AUTH_MODE=dev
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ---------------- Uploads & limits ----------------
MAX_UPLOAD_MB=10
RATE_LIMIT_WINDOW_MINUTES=15
# ~100 requests/minute per client; the upload limit below is stricter
RATE_LIMIT_MAX_REQUESTS=1500
UPLOAD_RATE_LIMIT_MAX=30

# ---------------- Reporting rules (deterministic validation) ----------------
# Federal subaward reporting threshold (2 CFR Part 170): $30,000
REPORTING_THRESHOLD=30000
# Records due within this many days are flagged "Due Soon"
DUE_SOON_DAYS=30
# Extracted values below this confidence must be verified by a human
LOW_CONFIDENCE_THRESHOLD=0.75

# Prime award context written to the export file (fictional demo values)
PRIME_AWARDEE_NAME=Riverbend Housing Coalition
PRIME_AWARD_ID=RHC-DEMO-FAIN-0001
